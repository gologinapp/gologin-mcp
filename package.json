{
  "name": "gologin-mcp",
  "version": "0.0.13",
  "description": "MCP server for managing GoLogin browser profiles, proxies, fingerprints and cloud browser sessions through AI conversations",
  "main": "dist/index.js",
  "files": [
    "dist/index.js"
  ],
  "bin": {
    "gologin-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "npm run build && node dist/index.js",
    "dev": "tsc --watch & node --watch dist/index.js",
    "test": "npm run build && node test-client.js",
    "clean": "rm -rf dist",
    "check:package": "node scripts/check-package.mjs",
    "release:check": "npm run build && npm run check:package",
    "prepublishOnly": "npm run clean && npm run release:check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.13.1",
    "js-yaml": "^4.1.0",
    "openapi-types": "^12.1.3",
    "swagger-parser": "^10.0.3",
    "agents": "^0.0.109",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "anti-detect browser",
    "gologin",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "browser",
    "browser-automation",
    "antidetect-browser",
    "proxy",
    "ai-agent",
    "openapi",
    "api-tools",
    "swagger",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gologinapp/gologin-mcp.git"
  },
  "homepage": "https://github.com/gologinapp/gologin-mcp#readme",
  "bugs": {
    "url": "https://github.com/gologinapp/gologin-mcp/issues"
  },
  "author": "",
  "license": "MIT"
}
